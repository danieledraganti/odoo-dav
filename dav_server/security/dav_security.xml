<odoo>
    <record id="res_groups_privilege_dav" model="res.groups.privilege">
        <field name="name">DAV</field>
        <field name="sequence">90</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_dav_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="comment">Can connect with DAV clients and read the data exposed by DAV (as limited by their regular Odoo access rights).</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_dav"/>
    </record>

    <record id="group_dav_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="comment">Can additionally modify data through DAV (still limited by their regular Odoo access rights).</field>
        <field name="implied_ids" eval="[(4, ref('group_dav_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_dav"/>
    </record>

    <record id="rule_dav_vcard_extra" model="ir.rule">
        <field name="name">DAV vCard extra: follows partner access</field>
        <field name="model_id" ref="model_dav_vcard_extra"/>
        <field name="domain_force">[('partner_id', 'any', [])]</field>
        <field name="groups" eval="[(4, ref('group_dav_user'))]"/>
    </record>
</odoo>
